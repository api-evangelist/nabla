  "info": {
    "_postman_id": "eb5c2f46-5d73-4e89-b76b-2cb9a3d61065",
    "name": "Nabla Core API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Nabla provides ambient AI for clinicians. The Core API supports\ntranscription (synchronous, asynchronous, and WebSocket) of medical\nencounters. The Server API issues OAuth 2.0 access tokens via JWT\nclient credentials, and the User API exchanges per-user JWT tokens\nso that client applications can call the Core API on behalf of a\nCopilot user.\n",
      "type": "text/plain"
    }
  }
